server {
    listen      80;
    listen      443 ssl;
    http2       on;
    server_name ${SERVER_NAME};
    charset     utf-8;
    root        /srv/ftp;
    ssl_certificate     /srv/ssl/server.crt;
    ssl_certificate_key /srv/ssl/server.key;
    fancyindex on;
    fancyindex_localtime on;
    fancyindex_exact_size off;
    fancyindex_header "/Nginx-Fancyindex/header.html";
    fancyindex_footer "/Nginx-Fancyindex/footer.html";
    fancyindex_name_length 255;
    fancyindex_ignore "Nginx-Fancyindex";
    location ^~ /Nginx-Fancyindex/ {
        alias /usr/share/nginx/fancyindex-theme/;
        fancyindex off;
        autoindex off;
    }
    location ~ ^/~([^/]+)(/.*)?$ {
        alias /home/$1/public_html$2;
        index  index.html;
    }
    index  index.html;
    location    /ebook {
        autoindex   off;
        return 403;
    }
    location    /movie {
        autoindex   off;
        return 403;
    }
    location    /wp-content/ {
        location /wp-content/gallery {
            root /srv/ftp;
        }
        location /wp-content/uploads {
            root /srv/ftp;
        }
        autoindex   off;
        return 403;
    }
}

server {
    listen      80  default_server;
    listen      443 default_server ssl;
    http2       on;
    return 444;
    ssl_reject_handshake on;
}
